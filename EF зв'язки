SELECT 
    g.Id AS GameId,
    g.Title AS GameTitle,
    g.Price,
    g.ReleaseYear,
    d.Name AS DeveloperName,
    d.Country AS DeveloperCountry
FROM Game g
INNER JOIN Developer d ON g.DeveloperId = d.Id;

SELECT 
    o.Id AS OrderId,
    o.OrderDate,
    c.FullName AS CustomerName,
    c.Email AS CustomerEmail,
    g.Title AS GameTitle,
    oi.Quantity,
    g.Price AS UnitPrice
FROM `Order` o
INNER JOIN Customer c ON o.CustomerId = c.Id
INNER JOIN OrderItem oi ON o.Id = oi.OrderId
INNER JOIN Game g ON oi.GameId = g.Id
ORDER BY o.Id;

SELECT 
    o.Id AS OrderId,
    c.FullName AS CustomerName,
    o.OrderDate,
    SUM(g.Price * oi.Quantity) AS TotalAmount
FROM `Order` o
INNER JOIN Customer c ON o.CustomerId = c.Id
INNER JOIN OrderItem oi ON o.Id = oi.OrderId
INNER JOIN Game g ON oi.GameId = g.Id
GROUP BY o.Id, c.FullName, o.OrderDate
ORDER BY o.Id;

SELECT 
    Id,
    Title,
    Price,
    ReleaseYear
FROM Game
ORDER BY Price DESC
LIMIT 3;

SELECT 
    c.Id AS CustomerId,
    c.FullName,
    c.Email,
    COUNT(o.Id) AS OrdersCount
FROM Customer c
INNER JOIN `Order` o ON c.Id = o.CustomerId
GROUP BY c.Id, c.FullName, c.Email
HAVING COUNT(o.Id) > 1;

SELECT 
    SUM(g.Price * oi.Quantity) AS TotalRevenue
FROM OrderItem oi
INNER JOIN Game g ON oi.GameId = g.Id;
