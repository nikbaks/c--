
using System;
using System.Net;
using System.Net.Sockets;
using System.Text;

class Program
{
    const string Host = "127.0.0.1";
    const int Port = 65432;
    const int Rounds = 5;

    static void Main(string[] args)
    {
        Console.OutputEncoding = Encoding.UTF8;
        Console.InputEncoding = Encoding.UTF8;

        Console.WriteLine("Оберіть режим роботи:");
        Console.WriteLine("1 - Запустити Сервер");
        Console.WriteLine("2 - Запустити Клієнт");
        Console.Write("Ваш вибір (1/2): ");
        string choice = Console.ReadLine()?.Trim();

        if (choice == "1")
        {
            RunServer();
        }
        else if (choice == "2")
        {
            RunClient();
        }
        else
        {
            Console.WriteLine("Некоректний вибір.");
        }
    }

    static int DetermineWinner(string p1, string p2)
    {
        if (p1 == p2) return 0;
        if ((p1 == "1" && p2 == "2") || (p1 == "2" && p2 == "3") || (p1 == "3" && p2 == "1")) return 1;
        return 2;
    }

    static string GetChoiceName(string choice)
    {
        return choice switch
        {
            "1" => "Камінь",
            "2" => "Ножиці",
            "3" => "Папір",
            _ => "Камінь"
        };
    }

    static void RunServer()
    {
        TcpListener server = new TcpListener(IPAddress.Parse(Host), Port);
        server.Start();
        Console.WriteLine($"Сервер запущено на {Host}:{Port}. Очікування двох гравців...");

        TcpClient p1 = server.AcceptTcpClient();
        Console.WriteLine($"Гравець 1 підключився: {p1.Client.RemoteEndPoint}");
        Send(p1, "Підключено! Очікування другого гравця...\n");

        TcpClient p2 = server.AcceptTcpClient();
        Console.WriteLine($"Гравець 2 підключився: {p2.Client.RemoteEndPoint}");
        Send(p2, "Підключено! Гра починається.\n");

        Send(p1, "Ви Гравець 1.\n");
        Send(p2, "Ви Гравець 2.\n");

        int p1Score = 0, p2Score = 0;

        for (int round = 1; round <= Rounds; round++)
        {
            string header = $"\n--- РАУНД {round} з {Rounds} ---\nВиберіть фігуру:\n1 - Камінь\n2 - Ножиці\n3 - Папір\nВаш вибір: ";
            Send(p1, header);
            Send(p2, header);

            string choice1 = Receive(p1).Trim();
            string choice2 = Receive(p2).Trim();

            if (choice1 != "1" && choice1 != "2" && choice1 != "3") choice1 = "1";
            if (choice2 != "1" && choice2 != "2" && choice2 != "3") choice2 = "1";

            int winner = DetermineWinner(choice1, choice2);

            string p1Res, p2Res;
            if (winner == 1)
            {
                p1Score++;
                p1Res = "Ви виграли цей раунд!";
                p2Res = "Ви програли цей раунд!";
            }
            else if (winner == 2)
            {
                p2Score++;
                p1Res = "Ви програли цей раунд!";
                p2Res = "Ви виграли цей раунд!";
            }
            else
            {
                p1Res = "Нічия в цьому раунді!";
                p2Res = "Нічия в цьому раунді!";
            }

            Send(p1, $"\nВаш вибір: {GetChoiceName(choice1)} | Суперник: {GetChoiceName(choice2)}\n{p1Res}\nРахунок -> Ви: {p1Score} | Суперник: {p2Score}\n");
            Send(p2, $"\nВаш вибір: {GetChoiceName(choice2)} | Суперник: {GetChoiceName(choice1)}\n{p2Res}\nРахунок -> Ви: {p2Score} | Суперник: {p1Score}\n");
        }

        string finalHeader = "\n================ ПІДСУМОК ПАРТІЇ ================\n";
        if (p1Score > p2Score)
        {
            Send(p1, $"{finalHeader}ПЕРЕМОГА! Рахунок: {p1Score}:{p2Score}\n");
            Send(p2, $"{finalHeader}ПОРАЗКА. Рахунок: {p2Score}:{p1Score}\n");
        }
        else if (p2Score > p1Score)
        {
            Send(p1, $"{finalHeader}ПОРАЗКА. Рахунок: {p1Score}:{p2Score}\n");
            Send(p2, $"{finalHeader}ПЕРЕМОГА! Рахунок: {p2Score}:{p1Score}\n");
        }
        else
        {
            Send(p1, $"{finalHeader}НІЧИЯ! Рахунок: {p1Score}:{p2Score}\n");
            Send(p2, $"{finalHeader}НІЧИЯ! Рахунок: {p2Score}:{p1Score}\n");
        }

        p1.Close();
        p2.Close();
        server.Stop();
        Console.WriteLine("Гра завершена. Клієнти від'єднані.");
    }

    static void RunClient()
    {
        try
        {
            using TcpClient client = new TcpClient(Host, Port);
            using NetworkStream stream = client.GetStream();
            Console.WriteLine("Успішне підключення до сервера!");

            byte[] buffer = new byte[1024];
            while (true)
            {
                int bytesRead = stream.Read(buffer, 0, buffer.Length);
                if (bytesRead == 0) break;

                string data = Encoding.UTF8.GetString(buffer, 0, bytesRead);
                Console.Write(data);

                if (data.Contains("Ваш вибір:"))
                {
                    string input = Console.ReadLine() ?? "";
                    byte[] sendBuf = Encoding.UTF8.GetBytes(input + "\n");
                    stream.Write(sendBuf, 0, sendBuf.Length);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"\nЗ'єднання з сервером втрачено або помилка: {ex.Message}");
        }

        Console.WriteLine("\nГра завершена. Від'єднання від сервера.");
    }

    static void Send(TcpClient client, string message)
    {
        byte[] buffer = Encoding.UTF8.GetBytes(message);
        client.GetStream().Write(buffer, 0, buffer.Length);
    }

    static string Receive(TcpClient client)
    {
        byte[] buffer = new byte[1024];
        int bytesRead = client.GetStream().Read(buffer, 0, buffer.Length);
        return Encoding.UTF8.GetString(buffer, 0, bytesRead);
    }
}
